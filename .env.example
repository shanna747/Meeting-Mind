PORT=3000

# Pinecone Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment
PINECONE_INDEX_NAME=meeting-mind

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Vector Search Configuration
VECTOR_DIMENSION=1536
TOP_K_RESULTS=5

# Zoom Integration
ZOOM_WEBHOOK_SECRET=your_zoom_webhook_secret_here

# Microsoft Teams Integration
TEAMS_CLIENT_ID=your_teams_client_id_here
TEAMS_CLIENT_SECRET=your_teams_client_secret_here
TEAMS_TENANT_ID=your_teams_tenant_id_here
TEAMS_REDIRECT_URI=http://localhost:3000/api/integrations/teams/auth/callback

# Google Meet Integration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google-meet/auth/callback